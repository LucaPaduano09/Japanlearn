@@ -0,0 +1,28 @@
+// swift-tools-version: 5.9
+import PackageDescription
+
+// Added by patches/ (the published plugin only ships a podspec): lets the
+// Capacitor 8 SPM project link it.
+let package = Package(
+    name: "CapacitorCommunitySpeechRecognition",
+    platforms: [.iOS(.v15)],
+    products: [
+        .library(
+            name: "CapacitorCommunitySpeechRecognition",
+            targets: ["SpeechRecognitionPlugin"])
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", from: "8.0.0")
+    ],
+    targets: [
+        .target(
+            name: "SpeechRecognitionPlugin",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm"),
+                .product(name: "Cordova", package: "capacitor-swift-pm")
+            ],
+            path: "ios/Plugin",
+            // The CAP_PLUGIN macro file is the CocoaPods registration; SPM uses CAPBridgedPlugin.
+            exclude: ["Plugin.m", "Plugin.h", "Info.plist"])
+    ]
+)
